// Icon shown in the Windows language switcher, and version info.
#include <winres.h>

101 ICON "akkhara.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Ing Muyleang"
      VALUE "FileDescription", "Akkhara Sing Khmer keyboard"
      VALUE "FileVersion", "0.2.0"
      VALUE "ProductName", "Akkhara"
      VALUE "ProductVersion", "0.2.0"
      VALUE "LegalCopyright", "Apache-2.0, Ing Muyleang"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
